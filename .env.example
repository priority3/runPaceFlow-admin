# Admin app
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-string
CONFIG_EXPORT_TOKEN=replace-with-a-long-random-token
# 主站只读 API 服务间 Token；部署主站时配置同一个值。
MAIN_SITE_API_TOKEN=replace-with-a-long-random-token

# ── 数据库:两个运行时库 + 一个镜像目标,勿混用同一个 URL ──
# ① admin 自己的配置/分析库(app_settings、scheduler、访问统计)
CONFIG_DATABASE_URL=file:./data/admin.db
CONFIG_DATABASE_AUTH_TOKEN=
# ② 活动/健康/PR agent 数据库(跑步、健康、记忆、对话、复盘)。admin 只认此键,不会回退到 ③。
ACTIVITIES_DATABASE_URL=file:./data/shared.db
ACTIVITIES_DATABASE_AUTH_TOKEN=
# ③ Turso 镜像/备份目标，仅由 Admin 使用；不会通过主站 API 下发。
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=your_turso_token

# ── pr-agent(PR 伙伴能力的 owner;本 UI 只当消费者)──
# 服务端调 pr-agent 管理 API 的地址。本部署两个容器都是 host 网络,填回环地址 + pr-agent
# 实际监听的端口(http://127.0.0.1:3040);若改成 bridge 网络则填服务名。
# 留空 = 不接 pr-agent,PR 相关面板走本仓自带的旧实现。
PR_AGENT_URL=
# 调 pr-agent 管理 API 的共享 token,须与 pr-agent 侧的 PR_ADMIN_TOKEN 同值。
PR_AGENT_TOKEN=
# pr-agent 写入 race_plans/race_goals/memory_items 的内部 API token；两边配置同一值。
PR_AGENT_DATA_TOKEN=
# 浏览器直接跳 pr-agent 对话页用的公网地址(如 https://pr.example.com);
# 与 NEXT_PUBLIC_ADMIN_URL 同理,不入配置面板,换域名改 env 重启容器即可。
NEXT_PUBLIC_PR_AGENT_URL=
NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_FORMAT=chat
