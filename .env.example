# Admin app
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-string
CONFIG_EXPORT_TOKEN=replace-with-a-long-random-token

# ── 数据库:三个角色,勿混用同一个 URL ──
# ① admin 自己的配置/分析库(app_settings、scheduler、访问统计)
CONFIG_DATABASE_URL=file:./data/admin.db
CONFIG_DATABASE_AUTH_TOKEN=
# ② 活动/健康/PR agent 数据库(跑步、健康、记忆、对话、复盘)。admin 只认此键,不会回退到 ③。
ACTIVITIES_DATABASE_URL=file:./data/shared.db
ACTIVITIES_DATABASE_AUTH_TOKEN=
# ③ 主站前端读取的库地址(经本 UI 的 app_settings 导出给主站,通常是远程 Turso)。
#    仅服务主站;admin 自身用 ①②,别让它们借用此键。
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=your_turso_token
NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
NIKE_ACCESS_TOKEN=
NIKE_REFRESH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_FORMAT=chat
